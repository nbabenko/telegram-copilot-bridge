TELEGRAM_BOT_TOKEN=1234567890:replace_me
BOT_USERNAME=your_bot_username_without_at
ALLOWED_USER_IDS=123456789
REPO_PATH=/absolute/path/to/target/repository
UPLOAD_DIR=/absolute/path/to/target/repository/.telegram-copilot-uploads
AI_PROVIDER=copilot
COPILOT_BIN=/usr/bin/copilot
CLAUDE_BIN=/usr/bin/claude
# Optional. Used only when AI_PROVIDER=claude. If set, command output is parsed
# to discover slash commands and expose them as Telegram commands.
CLAUDE_COMMANDS_DISCOVERY_CMD=claude -p "/help" --output-format text
# Optional. Colon-separated dirs with custom Claude slash commands (*.md)
CLAUDE_COMMANDS_DIRS=/absolute/path/to/target/repository/.claude/commands:/root/.claude/commands
COPILOT_TIMEOUT=1200
TELEGRAM_TIMEOUT=30
DEFAULT_VERBOSE=false
# Optional: GitHub Actions integration is enabled only if all vars below are set.
GITHUB_ACTIONS_REPO=
GITHUB_ACTIONS_TOKEN=
GITHUB_POLL_INTERVAL=45
# Optional: /upload is enabled only if all vars below are set.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_PREFIX=